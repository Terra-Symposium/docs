---
import { DocsLocalWorkspace } from '../LocalDocsWorkspace';
import { docsPages, docsTree } from '../docs-catalog';
import '../../lib-dist/style.css';

export function getStaticPaths() {
	return docsPages.map(page => ({
		params: { slug: page.id === 'index' ? undefined : page.id },
		props: { pageId: page.id },
	}));
}

const { pageId } = Astro.props;
const page = docsPages.find(entry => entry.id === pageId) ?? docsPages[0];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{page?.title ?? 'Terra Docs'}</title>
	</head>
	<body>
		<DocsLocalWorkspace client:load tree={docsTree} pages={docsPages} pathname={Astro.url.pathname} title="Terra Docs" description="Install and configure independent Terra Docs instances." rootPath="/" homePath="/" />
	</body>
</html>
