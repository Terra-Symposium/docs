{
  "name": "@terra-symposium/docs",
  "version": "0.1.6",
  "description": "Reusable React document editor and viewer.",
  "repository": "https://github.com/Terra-Symposium/docs",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.12.0"
  },
  "files": [
    "lib-dist",
    "src/style.css",
    "src/navigation.tsx",
    "src/SiteLayout.astro",
    "vendor/terra-symposium-styling-0.1.1.tgz"
  ],
  "exports": {
    ".": {
      "types": "./lib-dist/index.d.ts",
      "import": "./lib-dist/index.js"
    },
    "./style.css": "./src/style.css",
    "./site-layout.astro": "./src/SiteLayout.astro"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --open",
    "docs:dev": "astro dev --host 127.0.0.1 --open",
    "docs:build": "astro build",
    "docs:preview": "astro preview --host 127.0.0.1",
    "dev:library": "tsc --watch",
    "build": "tsc",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.demo.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test:browser": "pnpm docs:build && playwright test"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/react": "^7.1.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "6.1.2",
    "astro": "^7.4.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@carbon/icons-react": "11.90.0",
    "@portabletext/editor": "7.9.0",
    "@radix-ui/react-select": "2.4.1",
    "@terra-symposium/styling": "file:vendor/terra-symposium-styling-0.1.1.tgz",
    "katex": "^0.19.1",
    "marked": "^18.1.1",
    "sanitize-html": "^2.18.1"
  },
  "license": "Apache-2.0"
}
