{
  "name": "@terra-symposium/docs",
  "version": "0.1.58",
  "description": "Reusable React document editor and viewer.",
  "repository": "https://github.com/Terra-Symposium/docs",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.12.0"
  },
  "files": [
    "lib-dist",
    "src/components/navigation.tsx",
    "src/components/SiteLayout.astro",
    "src/components/NotFound.astro",
    "src/components/NotFound.tsx"
  ],
  "exports": {
    ".": {
      "types": "./lib-dist/lib/index.d.ts",
      "import": "./lib-dist/lib/index.js"
    },
    "./style.css": "./lib-dist/style.css",
    "./astro": {
      "types": "./lib-dist/lib/astro.d.ts",
      "import": "./lib-dist/lib/astro.js"
    },
    "./local-workspace": {
      "types": "./lib-dist/components/LocalDocsWorkspace.d.ts",
      "import": "./lib-dist/components/LocalDocsWorkspace.js"
    },
    "./site-layout.astro": "./src/components/SiteLayout.astro",
    "./not-found.astro": "./src/components/NotFound.astro"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --open",
    "docs:dev": "pnpm build && astro dev --host 127.0.0.1 --open",
    "docs:build": "pnpm build && astro build",
    "docs:preview": "pnpm docs:build && astro preview --host 127.0.0.1",
    "dev:library": "tsc --watch",
    "build": "rm -rf lib-dist && tsc && tailwindcss --postcss tailwind.postcss.config.cjs -c tailwind.docs.config.mjs -i src/styles/style.css -o lib-dist/style.css --minify && node scripts/copy-runtime.mjs",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.demo.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test:browser": "playwright test",
    "test:consumer": "playwright test --config=playwright.consumer.config.ts",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "peerDependencies": {
    "@terra-symposium/styling": "^0.1.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/react": "^7.1.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@terra-symposium/styling": "file:vendor/terra-symposium-styling-0.1.27.tgz",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "6.1.2",
    "astro": "^7.4.2",
    "eslint": "10.13.0",
    "husky": "^9.1.7",
    "postcss": "8.5.31",
    "postcss-import": "15.1.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^3.4.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@carbon/icons-react": "11.90.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.1.3",
    "@codemirror/language": "^6.11.3",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.4",
    "@dagrejs/dagre": "^1.1.4",
    "@lexical/rich-text": "^0.35.0",
    "@portabletext/editor": "7.9.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "2.4.1",
    "@uiw/codemirror-theme-github": "^4.25.9",
    "@xyflow/react": "^12.3.6",
    "jszip": "^3.10.1",
    "katex": "^0.19.1",
    "lexical": "^0.35.0",
    "marked": "^18.1.1",
    "nanostores": "^1.3.0",
    "pdf-lib": "^1.17.1",
    "sanitize-html": "^2.18.1",
    "sonner": "^1.4.41",
    "yaml": "^2.7.0"
  },
  "license": "Apache-2.0"
}
