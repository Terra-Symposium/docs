{
  "name": "@terra-symposium/docs",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone React document editor and viewer scaffold.",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.12.0"
  },
  "files": [
    "dist",
    "src/style.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./src/style.css"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --open",
    "dev:library": "tsc --watch",
    "build": "tsc",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.demo.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@carbon/icons-react": "11.90.0",
    "@portabletext/editor": "7.9.0",
    "@radix-ui/react-select": "2.4.1"
  }
}
